<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Module final : construit le zip de livraison (toujours le même nom).
        Le descripteur d'assembly (src/main/assembly/prod.xml ou dev.xml) copie dans lib/ les
        dépendances de ce module. Tout est piloté par le profil actif :
          - prod (actif par défaut) : lambda-shade -> lib/ = lambda-shade + annotations (promu)
          - dev  (-Pdev)            : lambda       -> lib/ = lambda + jakarta.annotation-api + annotations
    -->
    <parent>
        <groupId>fr.antschw.lambda</groupId>
        <artifactId>lambda-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lambda-assembly</artifactId>
    <!-- packaging pom : ce module ne produit pas de jar, seulement le zip -->
    <packaging>pom</packaging>
    <name>Lambda :: Assembly</name>

    <profiles>
        <!-- Profil par défaut (production) : jar shadé + dépendances promues -->
        <profile>
            <id>prod</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <assembly.descriptor>src/main/assembly/prod.xml</assembly.descriptor>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>lambda-shade</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <!--
            Profil des postes de développement, sur activation explicite : -Pdev
            (activer dev désactive automatiquement prod, qui n'est actif que "par défaut").
            Jar non shadé + ses dépendances, tirées par transitivité comme un projet normal.
        -->
        <profile>
            <id>dev</id>
            <properties>
                <assembly.descriptor>src/main/assembly/dev.xml</assembly.descriptor>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>lambda</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <!-- Descripteur choisi par le profil actif (dev.xml ou prod.xml) -->
                                <descriptor>${assembly.descriptor}</descriptor>
                            </descriptors>
                            <!-- Même nom en dev et en prod : target/lambda-assembly-1.0.0-SNAPSHOT.zip -->
                            <finalName>${project.artifactId}-${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
