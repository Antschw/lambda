<?xml version="1.0" encoding="UTF-8"?>
<!-- Partie commune aux deux zips (dev et prod) : les scripts de lancement -->
<component xmlns="http://maven.apache.org/ASSEMBLY-COMPONENT/2.2.0"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://maven.apache.org/ASSEMBLY-COMPONENT/2.2.0 https://maven.apache.org/xsd/assembly-component-2.2.0.xsd">
    <fileSets>
        <fileSet>
            <directory>src/main/dist/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>*.sh</include>
            </includes>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
        </fileSet>
        <fileSet>
            <directory>src/main/dist/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>*.bat</include>
            </includes>
            <lineEnding>dos</lineEnding>
        </fileSet>
    </fileSets>
</component>
