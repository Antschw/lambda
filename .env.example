# Copy to .env, fill in, then: set -a; . ./.env; set +a   (or docker run --env-file .env ...)
PROVIDER_A_API_KEY=
PROVIDER_B_API_KEY=
PROVIDER_C_API_KEY=
# Key your tools must send to the proxy. Leave empty to disable client authentication.
LLM_PROXY_LOCAL_KEY=
# 127.0.0.1 locally, 0.0.0.0 in a container.
LLM_PROXY_HOST=127.0.0.1
LLM_PROXY_PORT=4000
# TRACE, DEBUG, INFO, WARN or ERROR.
LOG_LEVEL=INFO
