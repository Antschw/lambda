<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Reprend "lambda" dans un jar shadé :
        - EMBARQUÉS (artifactSet/includes) : lambda + jakarta.annotation-api
        - PROMU (promoteTransitiveDependencies) : org.jetbrains:annotations, non embarqué,
          devient une dépendance directe du dependency-reduced-pom.

        Le dependency-reduced-pom (dependency-reduced-pom.xml) remplace le pom de ce module :
        il ne déclare plus que org.jetbrains:annotations.
    -->
    <parent>
        <groupId>fr.antschw.lambda</groupId>
        <artifactId>lambda-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lambda-shade</artifactId>
    <name>Lambda :: Shade</name>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lambda</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <promoteTransitiveDependencies>true</promoteTransitiveDependencies>
                            <artifactSet>
                                <includes>
                                    <include>fr.antschw.lambda:lambda</include>
                                    <include>jakarta.annotation:jakarta.annotation-api</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <!-- module-info.class et MANIFEST des jars embarqués n'ont pas de sens une fois fusionnés -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
