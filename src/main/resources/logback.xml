<configuration>
    <!-- Logs go to stdout only, so they work the same locally and in a container. -->
    <!-- Level: LOG_LEVEL environment variable (TRACE, DEBUG, INFO, WARN, ERROR), INFO by default. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{req:-main}] %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="jdk.internal.httpclient" level="WARN"/>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
